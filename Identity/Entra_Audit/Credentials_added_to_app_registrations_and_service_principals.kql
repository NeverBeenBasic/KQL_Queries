// Title: Credentials added to app registrations and service principals
// Category: Identity/Entra-Audit
// Description: Every secret or certificate added to an app or service principal in 30 days, with who did it. A new credential on an existing app is a common persistence step after an account takeover.
// Tables: AuditLogs
// Mitre: T1098.001

AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName has_any ("Certificates and secrets management", "Add service principal credentials")
| extend Actor = tostring(InitiatedBy.user.userPrincipalName), ActorApp = tostring(InitiatedBy.app.displayName),
         Target = tostring(TargetResources[0].displayName)
| project TimeGenerated, OperationName, Result, Actor, ActorApp, Target
| order by TimeGenerated desc
