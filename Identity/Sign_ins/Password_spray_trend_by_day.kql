// Title: Password spray trend by day
// Category: Identity/Sign-ins
// Description: Daily failed legacy-auth attempts with distinct users and source IPs, to show whether a spray is growing, steady or over.
// Tables: SigninLogs
// Mitre: T1110.003

SigninLogs
| where TimeGenerated > ago(30d)
| where UserAgent has "BAV2ROPC" or ClientAppUsed in ("Authenticated SMTP", "Other clients", "IMAP4", "POP3")
| where ResultType != "0"
| summarize Failures = count(), TargetedUsers = dcount(UserPrincipalName), SourceIPs = dcount(IPAddress)
    by Day = bin(TimeGenerated, 1d)
| order by Day asc
